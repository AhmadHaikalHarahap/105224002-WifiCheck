generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AUDITOR
  USER
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique @db.VarChar(255)
  passwordHash String       @db.VarChar(255)
  role         Role         @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sessions     Session[]
  assessments  Assessment[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Assessment {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String?   @db.Uuid
  ssid                   String    @db.VarChar(32)
  ssid_enc               Json?
  securityProtocol       String
  securityProtocol_enc   Json?
  passwordProtection     String
  passwordProtection_enc Json?
  wpsEnabled             String
  wpsEnabled_enc         Json?
  firmwareStatus         String
  firmwareStatus_enc     Json?
  notes                  String    @default("") @db.VarChar(250)
  notes_enc              Json?
  riskLevel              String
  summary                String    @db.Text
  summary_enc            Json?
  recommendations        Json
  recommendations_enc    Json?
  createdAt              DateTime  @default(now())

  user                   User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  findings               Finding[]

  @@index([createdAt])
  @@index([riskLevel])
  @@index([userId])
}

model Finding {
  id              String     @id @default(uuid()) @db.Uuid
  assessmentId    String     @db.Uuid
  title           String     @db.VarChar(120)
  title_enc       Json?
  description     String     @db.Text
  description_enc Json?
  severity        String
  isManual        Boolean    @default(false)
  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([severity])
}


model LoginRateLimit {
  identifier      String   @id @db.VarChar(64)
  attempts        Int      @default(0)
  windowStartedAt DateTime @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime @updatedAt

  @@index([blockedUntil])
}
